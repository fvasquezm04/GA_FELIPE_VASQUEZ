<?xml version="1.0"?>
<sdf version="1.10">
  <world name="pista">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- TODO (Parte 2): sistema de sensores (gz-sim-sensors-system) con render engine ogre2 -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Suelo con fricción (la cinemática asume rodadura sin deslizamiento) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Paredes (cuarto de 8 m x 8 m) -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>8 0.1 1</size></box></geometry></collision>
        <visual name="n"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>8 0.1 1</size></box></geometry></visual>
        <collision name="s"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>8 0.1 1</size></box></geometry></collision>
        <visual name="s"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>8 0.1 1</size></box></geometry></visual>
        <collision name="e"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.1 8 1</size></box></geometry></collision>
        <visual name="e"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.1 8 1</size></box></geometry></visual>
        <collision name="w"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.1 8 1</size></box></geometry></collision>
        <visual name="w"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.1 8 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Obstáculos para ver en LiDAR y cámara (fuera de las rutas) -->
    <model name="box_red">
      <static>true</static>
      <pose>3.2 0.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_green">
      <static>true</static>
      <pose>1.0 3.0 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cyl_blue">
      <static>true</static>
      <pose>-2.6 2.6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_yellow">
      <static>true</static>
      <pose>0.5 -2.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.8 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.8 0.6</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
